{
  "name": "qvac-eval",
  "version": "0.1.0",
  "description": "Regression tests for local AI models running on the QVAC SDK: YAML suites, golden outputs, performance numbers, and a report you can read offline.",
  "keywords": [
    "qvac",
    "llm",
    "evaluation",
    "regression-testing",
    "local-ai",
    "whisper",
    "embeddings",
    "github-actions"
  ],
  "homepage": "https://github.com/vinter-man/qvac-eval#readme",
  "bugs": {
    "url": "https://github.com/vinter-man/qvac-eval/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinter-man/qvac-eval.git"
  },
  "license": "MIT",
  "author": "vinter-man",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "bin": {
    "qvac-eval": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "assets",
    "models.yaml",
    "qvac-eval.config.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run format:check && npm run knip && npm run test:coverage",
    "knip": "knip",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@qvac/sdk": ">=0.21.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@qvac/sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
